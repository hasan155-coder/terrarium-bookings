{
  // Terrarium Bistro booking server. Cloudflare deploys this automatically from GitHub.
  "name": "terrarium-bookings",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-15",
  "observability": { "enabled": true },
  "rules": [{ "type": "Text", "globs": ["**/*.html", "**/*.sql"], "fallthrough": true }],
  "vars": {
    // http until GitHub issues the site's HTTPS certificate; once "Enforce HTTPS" is on, http links redirect to https anyway.
    "PUBLIC_SITE": "http://www.terrariumbistro.co.uk/",
    "BOOKINGS_URL": "https://terrarium-bookings.terrariumbistro.workers.dev",
    "STAFF_URL": "https://terrarium-bookings.terrariumbistro.workers.dev/staff",
    "MAIL_FROM": "Terrarium Bistro <bookings@terrariumbistro.co.uk>",
    "RESTAURANT_EMAIL": "info@terrariumbistro.co.uk"
  },
  // RESEND_API_KEY is a secret, added in the Cloudflare dashboard (never stored here).
  // Every hour, on the hour (UTC). The reminder run itself waits until 10:00 UK time.
  "triggers": { "crons": ["0 * * * *"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "terrarium-bookings", "database_id": "1ac206bb-ef8b-480b-aa60-3d2be1ff1b2f" }
  ]
}
